<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="ocean_fog">
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <update_rate>20.0</update_rate>
    </plugin>

    <scene>
      <ambient>0.18 0.20 0.22 1</ambient>
      <background>0.58 0.64 0.68 1</background>
      <shadows>false</shadows>
      <fog>
        <type>linear</type>
        <color>0.62 0.68 0.70 1</color>
        <start>8.0</start>
        <end>180.0</end>
        <density>0.018</density>
      </fog>
    </scene>

    <physics name="default_physics" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_update_rate>250</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>45</iters>
          <sor>1.2</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
        </constraints>
      </ode>
    </physics>

    <light name="diffuse_sun" type="directional">
      <pose>0 0 80 0 0 0</pose>
      <diffuse>0.55 0.56 0.54 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <direction>-0.2 0.4 -0.9</direction>
      <cast_shadows>false</cast_shadows>
    </light>

