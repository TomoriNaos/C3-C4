    <model name="scout_uav">
      <static>false</static>
      <!-- Normal scouting starts outside the USV's 30 m self-perception zone. -->
      <pose>42 0 5 0 0 3.1416</pose>
      <link name="base_link">
        <gravity>false</gravity>
        <velocity_decay>
          <linear>0.10</linear>
          <angular>0.20</angular>
        </velocity_decay>
        <inertial>
          <mass>6.0</mass>
          <inertia>
            <ixx>0.55</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.55</iyy><iyz>0</iyz><izz>0.90</izz>
          </inertia>
        </inertial>
        <visual name="body_visual">
          <geometry><box><size>0.90 0.42 0.20</size></box></geometry>
          <material>
            <ambient>0.05 0.15 0.40 1</ambient>
            <diffuse>0.05 0.28 0.82 1</diffuse>
          </material>
        </visual>
        <visual name="nose_visual">
          <pose>0.52 0 -0.01 0 0 0</pose>
          <geometry><box><size>0.34 0.30 0.16</size></box></geometry>
          <material>
            <ambient>0.02 0.08 0.12 1</ambient>
            <diffuse>0.04 0.18 0.24 1</diffuse>
          </material>
        </visual>
        <visual name="arm_x_visual">
          <pose>0 0 0.02 0 0 0.7854</pose>
          <geometry><box><size>1.95 0.08 0.06</size></box></geometry>
          <material>
            <ambient>0.08 0.08 0.08 1</ambient>
            <diffuse>0.10 0.10 0.10 1</diffuse>
          </material>
        </visual>
        <visual name="arm_y_visual">
          <pose>0 0 0.02 0 0 -0.7854</pose>
          <geometry><box><size>1.95 0.08 0.06</size></box></geometry>
          <material>
            <ambient>0.08 0.08 0.08 1</ambient>
            <diffuse>0.10 0.10 0.10 1</diffuse>
          </material>
        </visual>
        <visual name="rotor_front_left">
          <pose>0.72 0.72 0.08 0 0 0</pose>
          <geometry><cylinder><radius>0.26</radius><length>0.025</length></cylinder></geometry>
          <material>
            <ambient>0.03 0.03 0.03 0.85</ambient>
            <diffuse>0.03 0.03 0.03 0.85</diffuse>
          </material>
        </visual>
        <visual name="rotor_front_right">
          <pose>0.72 -0.72 0.08 0 0 0</pose>
          <geometry><cylinder><radius>0.26</radius><length>0.025</length></cylinder></geometry>
          <material>
            <ambient>0.03 0.03 0.03 0.85</ambient>
            <diffuse>0.03 0.03 0.03 0.85</diffuse>
          </material>
        </visual>
        <visual name="rotor_rear_left">
          <pose>-0.72 0.72 0.08 0 0 0</pose>
          <geometry><cylinder><radius>0.26</radius><length>0.025</length></cylinder></geometry>
          <material>
            <ambient>0.03 0.03 0.03 0.85</ambient>
            <diffuse>0.03 0.03 0.03 0.85</diffuse>
          </material>
        </visual>
        <visual name="rotor_rear_right">
          <pose>-0.72 -0.72 0.08 0 0 0</pose>
          <geometry><cylinder><radius>0.26</radius><length>0.025</length></cylinder></geometry>
          <material>
            <ambient>0.03 0.03 0.03 0.85</ambient>
            <diffuse>0.03 0.03 0.03 0.85</diffuse>
          </material>
        </visual>
        <visual name="gated_pod_visual">
          <pose>0.16 0 -0.20 0 0 0</pose>
          <geometry><box><size>0.32 0.24 0.18</size></box></geometry>
          <material>
            <ambient>0.08 0.08 0.08 1</ambient>
            <diffuse>0.12 0.12 0.12 1</diffuse>
          </material>
        </visual>
        <collision name="body_collision">
          <geometry><box><size>1.05 0.52 0.28</size></box></geometry>
        </collision>

        <!-- Four overlapping cameras remove the need to yaw the UAV before observing a contact. -->
        <sensor type="depth" name="uav_gated_camera">
          <pose>0.78 0 -0.12 0 0.55 0</pose>
          <visualize>false</visualize>
          <always_on>true</always_on>
          <update_rate>8.0</update_rate>
          <camera>
            <horizontal_fov>1.919862</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.2</near>
              <far>260.0</far>
            </clip>
          </camera>
          <plugin name="gazebo_ros_uav_gated_camera" filename="libgazebo_ros_camera.so">
            <ros>
              <remapping>~/image_raw:=uav/gated_camera/image_raw</remapping>
              <remapping>~/depth/image_raw:=uav/gated_camera/depth/image_raw</remapping>
              <remapping>~/camera_info:=uav/gated_camera/camera_info</remapping>
            </ros>
            <camera_name>uav/gated_camera</camera_name>
            <frame_name>uav_gated_camera_link</frame_name>
            <min_depth>0.2</min_depth>
            <max_depth>260.0</max_depth>
          </plugin>
        </sensor>

        <sensor type="depth" name="uav_gated_camera_right">
          <pose>0.78 0 -0.12 0 0.55 -1.570796</pose>
          <visualize>false</visualize><always_on>true</always_on><update_rate>8.0</update_rate>
          <camera><horizontal_fov>1.919862</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.2</near><far>260.0</far></clip></camera>
          <plugin name="gazebo_ros_uav_gated_camera_right" filename="libgazebo_ros_camera.so">
            <ros><remapping>~/image_raw:=uav/gated_camera/right/image_raw</remapping><remapping>~/depth/image_raw:=uav/gated_camera/right/depth/image_raw</remapping><remapping>~/camera_info:=uav/gated_camera/right/camera_info</remapping></ros>
            <camera_name>uav/gated_camera/right</camera_name><frame_name>uav_gated_camera_right_link</frame_name><min_depth>0.2</min_depth><max_depth>260.0</max_depth>
          </plugin>
        </sensor>

        <sensor type="depth" name="uav_gated_camera_back">
          <pose>0.78 0 -0.12 0 0.55 3.141593</pose>
          <visualize>false</visualize><always_on>true</always_on><update_rate>8.0</update_rate>
          <camera><horizontal_fov>1.919862</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.2</near><far>260.0</far></clip></camera>
          <plugin name="gazebo_ros_uav_gated_camera_back" filename="libgazebo_ros_camera.so">
            <ros><remapping>~/image_raw:=uav/gated_camera/back/image_raw</remapping><remapping>~/depth/image_raw:=uav/gated_camera/back/depth/image_raw</remapping><remapping>~/camera_info:=uav/gated_camera/back/camera_info</remapping></ros>
            <camera_name>uav/gated_camera/back</camera_name><frame_name>uav_gated_camera_back_link</frame_name><min_depth>0.2</min_depth><max_depth>260.0</max_depth>
          </plugin>
        </sensor>

        <sensor type="depth" name="uav_gated_camera_left">
          <pose>0.78 0 -0.12 0 0.55 1.570796</pose>
          <visualize>false</visualize><always_on>true</always_on><update_rate>8.0</update_rate>
          <camera><horizontal_fov>1.919862</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.2</near><far>260.0</far></clip></camera>
          <plugin name="gazebo_ros_uav_gated_camera_left" filename="libgazebo_ros_camera.so">
            <ros><remapping>~/image_raw:=uav/gated_camera/left/image_raw</remapping><remapping>~/depth/image_raw:=uav/gated_camera/left/depth/image_raw</remapping><remapping>~/camera_info:=uav/gated_camera/left/camera_info</remapping></ros>
            <camera_name>uav/gated_camera/left</camera_name><frame_name>uav_gated_camera_left_link</frame_name><min_depth>0.2</min_depth><max_depth>260.0</max_depth>
          </plugin>
        </sensor>

      </link>
    </model>

