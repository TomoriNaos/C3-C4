<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fog_usv">
  <!-- mmWave reflectivity annotations -->
  <xacro:property name="reflectivity_pontoon" value="0.92"/>
  <xacro:property name="reflectivity_deck" value="0.58"/>
  <xacro:property name="reflectivity_sensor" value="0.72"/>
  <xacro:property name="reflectivity_camera" value="0.66"/>

  <material name="pontoon_orange">
    <color rgba="1.0 0.42 0.08 1.0"/>
  </material>
  <material name="deck_dark">
    <color rgba="0.10 0.12 0.13 1.0"/>
  </material>
  <material name="sensor_black">
    <color rgba="0.01 0.01 0.01 1.0"/>
  </material>
  <material name="camera_blue">
    <color rgba="0.08 0.22 0.34 1.0"/>
  </material>

  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.28" rpy="0 0 0"/>
      <mass value="240.0"/>
      <inertia ixx="120.0" ixy="0.0" ixz="0.0" iyy="260.0" iyz="0.0" izz="320.0"/>
    </inertial>

    <visual name="port_pontoon">
      <origin xyz="0 0.95 0.0" rpy="0 ${pi / 2.0} 0"/>
      <geometry>
        <cylinder radius="0.24" length="5.4"/>
      </geometry>
      <material name="pontoon_orange"/>
    </visual>
    <visual name="starboard_pontoon">
      <origin xyz="0 -0.95 0.0" rpy="0 ${pi / 2.0} 0"/>
      <geometry>
        <cylinder radius="0.24" length="5.4"/>
      </geometry>
      <material name="pontoon_orange"/>
    </visual>
    <visual name="deck">
      <origin xyz="0 0 0.48" rpy="0 0 0"/>
      <geometry>
        <box size="3.3 1.55 0.18"/>
      </geometry>
      <material name="deck_dark"/>
    </visual>
    <visual name="bow_bridge">
      <origin xyz="1.15 0 0.72" rpy="0 0 0"/>
      <geometry>
        <box size="0.9 1.0 0.32"/>
      </geometry>
      <material name="deck_dark"/>
    </visual>
    <visual name="sensor_mast">
      <origin xyz="-0.35 0 1.18" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="1.28"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>

    <collision name="port_pontoon_collision">
      <origin xyz="0 0.95 0.0" rpy="0 ${pi / 2.0} 0"/>
      <geometry>
        <cylinder radius="0.26" length="5.5"/>
      </geometry>
    </collision>
    <collision name="starboard_pontoon_collision">
      <origin xyz="0 -0.95 0.0" rpy="0 ${pi / 2.0} 0"/>
      <geometry>
        <cylinder radius="0.26" length="5.5"/>
      </geometry>
    </collision>
    <collision name="deck_collision">
      <origin xyz="0 0 0.48" rpy="0 0 0"/>
      <geometry>
        <box size="3.4 1.65 0.22"/>
      </geometry>
    </collision>
  </link>

  <gazebo reference="base_link">
    <gravity>false</gravity>
    <material>Gazebo/Orange</material>
    <mmwave_reflectivity>${reflectivity_pontoon}</mmwave_reflectivity>
  </gazebo>

  <!-- ========================================================= -->
  <!-- 4 x 120° mmWave radars for 360° coverage                  -->
  <!-- Each radar publishes a LaserScan raw topic.               -->
  <!-- ========================================================= -->
  <xacro:macro name="mmwave_radar" params="name x y z yaw topic">
    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.18" length="0.09"/>
        </geometry>
        <material name="sensor_black"/>
      </visual>
    </link>

    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 ${yaw}"/>
    </joint>

    <gazebo reference="${name}_link">
      <mmwave_reflectivity>${reflectivity_sensor}</mmwave_reflectivity>
      <sensor type="ray" name="${name}_raw_sensor">
        <pose>0 0 0 0 0 0</pose>
        <visualize>true</visualize>
        <update_rate>15</update_rate>
        <ray>
          <scan>
            <horizontal>
              <!-- 120° FOV: -60° to +60° relative to this radar link -->
              <samples>800</samples>
              <resolution>1</resolution>
              <min_angle>-1.0472</min_angle>
              <max_angle>1.0472</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>1.0</min>
            <max>800.0</max>
            <resolution>0.5</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.08</stddev>
          </noise>
        </ray>
        <plugin name="gazebo_ros_${name}" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <remapping>~/out:=${topic}</remapping>
          </ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>${name}_link</frame_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- Front radar: covers roughly -60° to +60° -->
  <xacro:mmwave_radar
    name="radar_front_2p5m"
    x="-0.35"
    y="0.0"
    z="2.5"
    yaw="0.0"
    topic="radar/front/raw_scan"/>

  <!-- Left radar: covers roughly +30° to +150° -->
  <xacro:mmwave_radar
    name="radar_left_2p5m"
    x="-0.35"
    y="0.0"
    z="2.5"
    yaw="1.5707963"
    topic="radar/left/raw_scan"/>

  <!-- Right radar: covers roughly -150° to -30° -->
  <xacro:mmwave_radar
    name="radar_right_2p5m"
    x="-0.35"
    y="0.0"
    z="2.5"
    yaw="-1.5707963"
    topic="radar/right/raw_scan"/>

  <!-- Rear radar: covers roughly +120° to +240° / -240° to -120° -->
  <xacro:mmwave_radar
    name="radar_rear_2p5m"
    x="-0.35"
    y="0.0"
    z="2.5"
    yaw="3.1415926"
    topic="radar/rear/raw_scan"/>




    




    







  <link name="depth_camera_link">
    <visual>
      <geometry>
        <box size="0.18 0.16 0.12"/>
      </geometry>
      <material name="camera_blue"/>
    </visual>
  </link>
  <joint name="depth_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="depth_camera_link"/>
    <origin xyz="1.65 0 0.98" rpy="0 0 0"/>
  </joint>

  <gazebo reference="depth_camera_link">
    <sensor type="depth" name="depth_camera">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>30.0</update_rate>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>800</width>
          <height>600</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>80.0</far>
        </clip>
      </camera>
      <plugin name="gazebo_ros_depth_camera" filename="libgazebo_ros_camera.so">
        <ros>
          <remapping>~/image_raw:=depth_camera/image_raw</remapping>
          <remapping>~/depth/image_raw:=depth_camera/depth/image_raw</remapping>
          <remapping>~/camera_info:=depth_camera/camera_info</remapping>
        </ros>
        <camera_name>depth_camera</camera_name>
        <frame_name>depth_camera_link</frame_name>
        <min_depth>0.1</min_depth>
        <max_depth>80.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>

  <link name="sonar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 ${pi / 2.0} 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.16"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>
  </link>
  <joint name="sonar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sonar_link"/>
    <origin xyz="0.65 0 -0.28" rpy="0 ${pi / 2.0} 0"/>
  </joint>

  <gazebo reference="sonar_link">
    <sensor type="ray" name="sonar_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>8</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>9</samples>
            <resolution>1</resolution>
            <min_angle>-0.16</min_angle>
            <max_angle>0.16</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.2</min>
          <max>60.0</max>
          <resolution>0.03</resolution>
        </range>
      </ray>
      <plugin name="gazebo_ros_sonar" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=sonar/range</remapping>
        </ros>
        <output_type>sensor_msgs/Range</output_type>
        <frame_name>sonar_link</frame_name>
        <radiation_type>ultrasound</radiation_type>
      </plugin>
    </sensor>
  </gazebo>

    <!-- IMU sensor mounted on the main USV body -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.08 0.04"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.75" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_link">
    <material>Gazebo/Black</material>
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>100.0</update_rate>
      <plugin name="gazebo_ros_imu_sensor" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/wamv</namespace>
          <remapping>~/out:=imu/data</remapping>
        </ros>
        <frame_name>imu_link</frame_name>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>


  <gazebo>
    <plugin name="usv_planar_move" filename="libgazebo_ros_planar_move.so">
      <ros>
        <namespace>/wamv</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <update_rate>50.0</update_rate>
    </plugin>
  </gazebo>
</robot>
