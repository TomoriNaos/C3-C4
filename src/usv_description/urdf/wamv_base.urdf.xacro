<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fog_usv">
  <xacro:arg name="enable_c3_mmwave" default="true"/>

  <material name="pontoon_orange">
    <color rgba="1.0 0.42 0.08 1.0"/>
  </material>
  <material name="deck_dark">
    <color rgba="0.10 0.12 0.13 1.0"/>
  </material>
  <material name="sensor_black">
    <color rgba="0.01 0.01 0.01 1.0"/>
  </material>
  <material name="camera_blue">
    <color rgba="0.08 0.22 0.34 1.0"/>
  </material>

  <xacro:macro name="c3_raw_mmwave_sensor" params="name height yaw topic">
    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.18" length="0.09"/>
        </geometry>
        <material name="sensor_black"/>
      </visual>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="-0.35 0 ${height}" rpy="0 0 ${yaw}"/>
    </joint>

    <gazebo reference="${name}_link">
      <sensor type="ray" name="${name}_raw_sensor">
        <pose>0 0 0 0 0 0</pose>
        <visualize>false</visualize>
        <update_rate>15</update_rate>
        <ray>
          <scan>
            <horizontal>
              <!-- Four 110 degree sectors overlap by 20 degrees to avoid
                   cardinal-direction blind gaps from hull occlusion. -->
              <samples>385</samples>
              <resolution>1</resolution>
              <min_angle>-0.959931</min_angle>
              <max_angle>0.959931</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>1.0</min>
            <max>800.0</max>
            <resolution>0.5</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.08</stddev>
          </noise>
        </ray>
        <plugin name="gazebo_ros_${name}_raw" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <remapping>~/out:=${topic}</remapping>
          </ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>${name}_link</frame_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>

  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.28" rpy="0 0 0"/>
      <mass value="240.0"/>
      <inertia ixx="120.0" ixy="0.0" ixz="0.0" iyy="260.0" iyz="0.0" izz="320.0"/>
    </inertial>

    <visual name="port_pontoon">
      <origin xyz="0 0.95 0.0" rpy="0 ${pi / 2.0} 0"/>
      <geometry>
        <cylinder radius="0.24" length="5.4"/>
      </geometry>
      <material name="pontoon_orange"/>
    </visual>
    <visual name="starboard_pontoon">
      <origin xyz="0 -0.95 0.0" rpy="0 ${pi / 2.0} 0"/>
      <geometry>
        <cylinder radius="0.24" length="5.4"/>
      </geometry>
      <material name="pontoon_orange"/>
    </visual>
    <visual name="deck">
      <origin xyz="0 0 0.48" rpy="0 0 0"/>
      <geometry>
        <box size="3.3 1.55 0.18"/>
      </geometry>
      <material name="deck_dark"/>
    </visual>
    <visual name="bow_bridge">
      <origin xyz="1.15 0 0.72" rpy="0 0 0"/>
      <geometry>
        <box size="0.9 1.0 0.32"/>
      </geometry>
      <material name="deck_dark"/>
    </visual>
    <visual name="sensor_mast">
      <origin xyz="-0.35 0 2.29" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="3.42"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>
    <visual name="mmwave_mount_1p9m">
      <origin xyz="-0.35 0 1.90" rpy="0 ${pi / 2.0} 0"/>
      <geometry>
        <cylinder radius="0.13" length="0.42"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>
    <visual name="mmwave_mount_3m">
      <origin xyz="-0.35 0 3.00" rpy="0 ${pi / 2.0} 0"/>
      <geometry>
        <cylinder radius="0.13" length="0.42"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>
    <visual name="mmwave_mount_4m">
      <origin xyz="-0.35 0 4.00" rpy="0 ${pi / 2.0} 0"/>
      <geometry>
        <cylinder radius="0.13" length="0.42"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>

    <collision name="port_pontoon_collision">
      <origin xyz="0 0.95 0.0" rpy="0 ${pi / 2.0} 0"/>
      <geometry>
        <cylinder radius="0.26" length="5.5"/>
      </geometry>
    </collision>
    <collision name="starboard_pontoon_collision">
      <origin xyz="0 -0.95 0.0" rpy="0 ${pi / 2.0} 0"/>
      <geometry>
        <cylinder radius="0.26" length="5.5"/>
      </geometry>
    </collision>
    <collision name="deck_collision">
      <origin xyz="0 0 0.48" rpy="0 0 0"/>
      <geometry>
        <box size="3.4 1.65 0.22"/>
      </geometry>
    </collision>
  </link>

  <gazebo reference="base_link">
    <gravity>false</gravity>
    <velocity_decay>
      <linear>0.25</linear>
      <angular>0.35</angular>
    </velocity_decay>
    <material>Gazebo/Orange</material>
  </gazebo>

  <link name="mmwave_radar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.18" length="0.09"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>
  </link>
  <joint name="mmwave_radar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mmwave_radar_link"/>
    <origin xyz="-0.35 0 1.86" rpy="0 0 0"/>
  </joint>

  <gazebo reference="mmwave_radar_link">
    <sensor type="ray" name="mmwave_radar_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>8</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-${pi}</min_angle>
            <max_angle>${pi}</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.25</min>
          <max>120.0</max>
          <resolution>0.02</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_mmwave_radar" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=mmwave_radar/scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>mmwave_radar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <xacro:if value="$(arg enable_c3_mmwave)">
    <xacro:c3_raw_mmwave_sensor name="radar_3m_front" height="3.0" yaw="0.0" topic="radar/front/h3m/raw_scan"/>
    <xacro:c3_raw_mmwave_sensor name="radar_3m_right" height="3.0" yaw="-1.570796" topic="radar/right/h3m/raw_scan"/>
    <xacro:c3_raw_mmwave_sensor name="radar_3m_back" height="3.0" yaw="3.141593" topic="radar/back/h3m/raw_scan"/>
    <xacro:c3_raw_mmwave_sensor name="radar_3m_left" height="3.0" yaw="1.570796" topic="radar/left/h3m/raw_scan"/>
    <xacro:c3_raw_mmwave_sensor name="radar_4m_front" height="4.0" yaw="0.0" topic="radar/front/h4m/raw_scan"/>
    <xacro:c3_raw_mmwave_sensor name="radar_4m_right" height="4.0" yaw="-1.570796" topic="radar/right/h4m/raw_scan"/>
    <xacro:c3_raw_mmwave_sensor name="radar_4m_back" height="4.0" yaw="3.141593" topic="radar/back/h4m/raw_scan"/>
    <xacro:c3_raw_mmwave_sensor name="radar_4m_left" height="4.0" yaw="1.570796" topic="radar/left/h4m/raw_scan"/>
    <xacro:c3_raw_mmwave_sensor name="radar_1p9m_front" height="1.9" yaw="0.0" topic="radar/front/h1p9m/raw_scan"/>
    <xacro:c3_raw_mmwave_sensor name="radar_1p9m_right" height="1.9" yaw="-1.570796" topic="radar/right/h1p9m/raw_scan"/>
    <xacro:c3_raw_mmwave_sensor name="radar_1p9m_back" height="1.9" yaw="3.141593" topic="radar/back/h1p9m/raw_scan"/>
    <xacro:c3_raw_mmwave_sensor name="radar_1p9m_left" height="1.9" yaw="1.570796" topic="radar/left/h1p9m/raw_scan"/>
  </xacro:if>

  <link name="depth_camera_link">
    <visual>
      <geometry>
        <box size="0.18 0.16 0.12"/>
      </geometry>
      <material name="camera_blue"/>
    </visual>
  </link>
  <joint name="depth_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="depth_camera_link"/>
    <origin xyz="1.65 0 0.98" rpy="0 0 0"/>
  </joint>

  <gazebo reference="depth_camera_link">
    <sensor type="depth" name="depth_camera">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>10.0</update_rate>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>80.0</far>
        </clip>
      </camera>
      <plugin name="gazebo_ros_depth_camera" filename="libgazebo_ros_camera.so">
        <ros>
          <remapping>~/image_raw:=depth_camera/image_raw</remapping>
          <remapping>~/depth/image_raw:=depth_camera/depth/image_raw</remapping>
          <remapping>~/camera_info:=depth_camera/camera_info</remapping>
        </ros>
        <camera_name>depth_camera</camera_name>
        <frame_name>depth_camera_link</frame_name>
        <min_depth>0.1</min_depth>
        <max_depth>80.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Four overlapping 110 degree gated RGB-D cameras provide full-surround vision. -->
  <xacro:macro name="c3_gated_camera_sensor" params="name x y z yaw topic visualize">
    <link name="${name}_link">
      <visual>
        <geometry>
          <box size="0.20 0.18 0.14"/>
        </geometry>
        <material name="camera_blue"/>
      </visual>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 ${yaw}"/>
    </joint>
    <gazebo reference="${name}_link">
      <sensor type="depth" name="${name}">
        <pose>0 0 0 0 0 0</pose>
        <visualize>${visualize}</visualize>
        <update_rate>12.0</update_rate>
        <camera>
          <horizontal_fov>1.919862</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>120.0</far>
          </clip>
        </camera>
        <plugin name="gazebo_ros_${name}" filename="libgazebo_ros_camera.so">
          <ros>
            <remapping>~/image_raw:=${topic}/image_raw</remapping>
            <remapping>~/depth/image_raw:=${topic}/depth/image_raw</remapping>
            <remapping>~/camera_info:=${topic}/camera_info</remapping>
          </ros>
          <camera_name>${topic}</camera_name>
          <frame_name>${name}_link</frame_name>
          <min_depth>0.05</min_depth>
          <max_depth>120.0</max_depth>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:c3_gated_camera_sensor name="gated_camera" x="1.55" y="0" z="1.20" yaw="0" topic="gated_camera" visualize="true"/>
  <xacro:c3_gated_camera_sensor name="gated_camera_right" x="0" y="-1.15" z="1.20" yaw="-1.570796" topic="gated_camera/right" visualize="false"/>
  <xacro:c3_gated_camera_sensor name="gated_camera_back" x="-1.55" y="0" z="1.20" yaw="3.141593" topic="gated_camera/back" visualize="false"/>
  <xacro:c3_gated_camera_sensor name="gated_camera_left" x="0" y="1.15" z="1.20" yaw="1.570796" topic="gated_camera/left" visualize="false"/>

  <xacro:macro name="sonar_sector_sensor" params="name yaw topic">
  <link name="${name}_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 ${pi / 2.0} 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.16"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>
  </link>
  <joint name="${name}_joint" type="fixed">
    <parent link="base_link"/>
    <child link="${name}_link"/>
    <origin xyz="0.65 0 -0.28" rpy="0 0 ${yaw}"/>
  </joint>

  <gazebo reference="${name}_link">
    <sensor type="ray" name="${name}_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>6</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>91</samples>
            <resolution>1</resolution>
            <min_angle>-0.785398</min_angle>
            <max_angle>0.785398</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>4.0</min>
          <max>60.0</max>
          <resolution>0.03</resolution>
        </range>
      </ray>
      <plugin name="gazebo_ros_${name}" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=${topic}</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>${name}_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  </xacro:macro>

  <xacro:sonar_sector_sensor name="sonar_front" yaw="0.0" topic="sonar/scan"/>
  <xacro:sonar_sector_sensor name="sonar_right" yaw="-1.570796" topic="sonar/right_scan"/>
  <xacro:sonar_sector_sensor name="sonar_back" yaw="3.141593" topic="sonar/back_scan"/>
  <xacro:sonar_sector_sensor name="sonar_left" yaw="1.570796" topic="sonar/left_scan"/>
</robot>
