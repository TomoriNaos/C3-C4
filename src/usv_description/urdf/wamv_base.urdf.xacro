<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fog_usv">
  <!-- mmWave reflectivity annotations -->
  <xacro:property name="reflectivity_pontoon" value="0.92"/>
  <xacro:property name="reflectivity_deck" value="0.58"/>
  <xacro:property name="reflectivity_sensor" value="0.72"/>
  <xacro:property name="reflectivity_camera" value="0.66"/>

  <material name="pontoon_orange">
    <color rgba="1.0 0.42 0.08 1.0"/>
  </material>
  <material name="deck_dark">
    <color rgba="0.10 0.12 0.13 1.0"/>
  </material>
  <material name="sensor_black">
    <color rgba="0.01 0.01 0.01 1.0"/>
  </material>
  <material name="camera_blue">
    <color rgba="0.08 0.22 0.34 1.0"/>
  </material>

  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.28" rpy="0 0 0"/>
      <mass value="240.0"/>
      <inertia ixx="120.0" ixy="0.0" ixz="0.0" iyy="260.0" iyz="0.0" izz="320.0"/>
    </inertial>

    <visual name="port_pontoon">
      <origin xyz="0 0.95 0.0" rpy="0 ${pi / 2.0} 0"/>
      <geometry>
        <cylinder radius="0.24" length="5.4"/>
      </geometry>
      <material name="pontoon_orange"/>
    </visual>
    <visual name="starboard_pontoon">
      <origin xyz="0 -0.95 0.0" rpy="0 ${pi / 2.0} 0"/>
      <geometry>
        <cylinder radius="0.24" length="5.4"/>
      </geometry>
      <material name="pontoon_orange"/>
    </visual>
    <visual name="deck">
      <origin xyz="0 0 0.48" rpy="0 0 0"/>
      <geometry>
        <box size="3.3 1.55 0.18"/>
      </geometry>
      <material name="deck_dark"/>
    </visual>
    <visual name="bow_bridge">
      <origin xyz="1.15 0 0.72" rpy="0 0 0"/>
      <geometry>
        <box size="0.9 1.0 0.32"/>
      </geometry>
      <material name="deck_dark"/>
    </visual>
    <visual name="sensor_mast">
      <origin xyz="-0.35 0 1.18" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="1.28"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>

    <collision name="port_pontoon_collision">
      <origin xyz="0 0.95 0.0" rpy="0 ${pi / 2.0} 0"/>
      <geometry>
        <cylinder radius="0.26" length="5.5"/>
      </geometry>
    </collision>
    <collision name="starboard_pontoon_collision">
      <origin xyz="0 -0.95 0.0" rpy="0 ${pi / 2.0} 0"/>
      <geometry>
        <cylinder radius="0.26" length="5.5"/>
      </geometry>
    </collision>
    <collision name="deck_collision">
      <origin xyz="0 0 0.48" rpy="0 0 0"/>
      <geometry>
        <box size="3.4 1.65 0.22"/>
      </geometry>
    </collision>
  </link>

  <gazebo reference="base_link">
    <gravity>false</gravity>
    <material>Gazebo/Orange</material>
    <mmwave_reflectivity>${reflectivity_pontoon}</mmwave_reflectivity>
  </gazebo>


    <link name="radar_10m_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.18" length="0.09"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>
  </link>
  <joint name="radar_10m_joint" type="fixed">
    <parent link="base_link"/>
    <child link="radar_10m_link"/>
    <origin xyz="-0.35 0 10.0" rpy="0 0 0"/>
  </joint>

  <gazebo reference="radar_10m_link">
    <mmwave_reflectivity>${reflectivity_sensor}</mmwave_reflectivity>
    <sensor type="ray" name="mmwave_raw_sensor_10m">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>15</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>400</samples>
            <resolution>1</resolution>
            <min_angle>-1.0472</min_angle>
            <max_angle>1.0472</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>1.0</min>
          <max>800.0</max>
          <resolution>0.5</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.08</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_mmwave_raw_10m" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=radar_10m/raw_scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>radar_10m_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <link name="radar_4m_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.18" length="0.09"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>
  </link>
  <joint name="radar_4m_joint" type="fixed">
    <parent link="base_link"/>
    <child link="radar_4m_link"/>
    <origin xyz="-0.35 0 4.0" rpy="0 0 0"/>
  </joint>

  <gazebo reference="radar_4m_link">
    <mmwave_reflectivity>${reflectivity_sensor}</mmwave_reflectivity>
    <sensor type="ray" name="mmwave_raw_sensor_4m">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>15</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>400</samples>
            <resolution>1</resolution>
            <min_angle>-1.0472</min_angle>
            <max_angle>1.0472</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>1.0</min>
          <max>800.0</max>
          <resolution>0.5</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.08</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_mmwave_raw_4m" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=radar_4m/raw_scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>radar_4m_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <link name="radar_1p9m_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.18" length="0.09"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>
  </link>
  <joint name="radar_1p9m_joint" type="fixed">
    <parent link="base_link"/>
    <child link="radar_1p9m_link"/>
    <origin xyz="-0.35 0 1.9" rpy="0 0 0"/>
  </joint>

  <gazebo reference="radar_1p9m_link">
    <mmwave_reflectivity>${reflectivity_sensor}</mmwave_reflectivity>
    <sensor type="ray" name="mmwave_raw_sensor_1p9m">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>15</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>400</samples>
            <resolution>1</resolution>
            <min_angle>-1.0472</min_angle>
            <max_angle>1.0472</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>1.0</min>
          <max>800.0</max>
          <resolution>0.5</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.08</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_mmwave_raw_1p9m" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=radar_1p9m/raw_scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>radar_1p9m_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <link name="radar_1p5m_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.18" length="0.09"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>
  </link>
  <joint name="radar_1p5m_joint" type="fixed">
    <parent link="base_link"/>
    <child link="radar_1p5m_link"/>
    <origin xyz="-0.35 0 1.5" rpy="0 0 0"/>
  </joint>

  <gazebo reference="radar_1p5m_link">
    <mmwave_reflectivity>${reflectivity_sensor}</mmwave_reflectivity>
    <sensor type="ray" name="mmwave_raw_sensor_1p5m">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>15</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>400</samples>
            <resolution>1</resolution>
            <min_angle>-1.0472</min_angle>
            <max_angle>1.0472</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>1.0</min>
          <max>800.0</max>
          <resolution>0.5</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.08</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_mmwave_raw_1p5m" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=radar_1p5m/raw_scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>radar_1p5m_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <link name="radar_1m_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.18" length="0.09"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>
  </link>
  <joint name="radar_1m_joint" type="fixed">
    <parent link="base_link"/>
    <child link="radar_1m_link"/>
    <origin xyz="-0.35 0 1.0" rpy="0 0 0"/>
  </joint>

  <gazebo reference="radar_1m_link">
    <mmwave_reflectivity>${reflectivity_sensor}</mmwave_reflectivity>
    <sensor type="ray" name="mmwave_raw_sensor_1m">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>15</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>400</samples>
            <resolution>1</resolution>
            <min_angle>-1.0472</min_angle>
            <max_angle>1.0472</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>1.0</min>
          <max>800.0</max>
          <resolution>0.5</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.08</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_mmwave_raw_1m" filename="libgazebo_ros_ray_sensor.so">
