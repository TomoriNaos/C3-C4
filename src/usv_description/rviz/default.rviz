Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF1
        - /RobotModel1
        - /Tracking Markers1
        - /Gated Range View1
        - /UAV Gated Camera View1
        - /Gated Detection Points1
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
  - Class: rviz_common/Time
    Name: Time
  - Class: usv_rviz_dashboard/PerceptionDashboard
    Name: 多模态感知总览
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Sea Grid
      Enabled: true
      Cell Size: 5
      Plane: XY
      Plane Cell Count: 30
      Color: 90; 105; 110
      Alpha: 0.35
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: Raw mmWave Radar
      Enabled: true
      Topic:
        Value: /radar/front/h3m/raw_scan
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Style: Points
      Size (m): 0.08
      Color: 255; 205; 65
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: Forward Sonar
      Enabled: true
      Topic:
        Value: /sonar/scan
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Style: Points
      Size (m): 0.12
      Color: 80; 220; 255
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Gated Detection Points
      Enabled: true
      Topic:
        Value: /gated_camera/detection_points
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Style: Spheres
      Size (m): 0.35
      Color Transformer: Intensity
      Channel Name: intensity
      Min Intensity: 0
      Max Intensity: 1
      Queue Size: 10
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: C3 Integrated Cloud
      Enabled: true
      Topic:
        Value: /c3/buffer/integrated_cloud
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Style: Spheres
      Size (m): 0.25
      Color Transformer: Intensity
      Channel Name: intensity
      Min Intensity: 0
      Max Intensity: 1
      Queue Size: 10
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Tracking Markers
      Enabled: true
      Marker Topic:
        Value: /tracked_objects
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Queue Size: 100
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Simulated Target Markers
      Enabled: true
      Marker Topic:
        Value: /simulated_targets
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Queue Size: 100
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: UAV Marker
      Enabled: true
      Marker Topic:
        Value: /uav/status_marker
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Queue Size: 20
      Value: true
    - Class: rviz_default_plugins/PoseArray
      Name: Tracked Object Poses
      Enabled: true
      Topic:
        Value: /tracked_object_poses
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Shape: Arrow (Flat)
      Arrow Length: 0.8
      Color: 120; 255; 255
      Value: true
  Enabled: true
  Global Options:
    Background Color: 35; 40; 42
    Fixed Frame: world
    Frame Rate: 20
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/PublishPoint
      Topic:
        Value: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Patrol View
      Target Frame: world
      Distance: 36
      Pitch: 0.72
      Yaw: 0.68
      Focal Point:
        X: 12
        Y: 0
        Z: 1
      Value: Orbit (rviz)
Window Geometry:
  Height: 1050
  Width: 1800
  X: 60
  Y: 40
