<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_lidar_robot">

    <!-- 底盘 -->
    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.4 0.2 0.1"/>
            </geometry>
            <material name="blue">
                <color rgba="0 0 1 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.4 0.2 0.1"/>
            </geometry>
        </collision>
    </link>

    <!-- 激光雷达 -->
    <link name="laser_link">
        <visual>
            <geometry>
                <cylinder length="0.05" radius="0.05"/>
            </geometry>
            <material name="red">
                <color rgba="1 0 0 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.05" radius="0.05"/>
            </geometry>
        </collision>
    </link>

    <joint name="laser_joint" type="fixed">
        <parent link="base_link"/>
        <child link="laser_link"/>
        <origin xyz="0 0 0.1" rpy="0 0 0"/>
    </joint>

    <!-- 毫米波雷达 -->
    <link name="mmwave_link">
        <visual>
            <geometry>
                <box size="0.08 0.05 0.03"/>
            </geometry>
            <material name="green">
                <color rgba="0 1 0 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.08 0.05 0.03"/>
            </geometry>
        </collision>
    </link>

    <joint name="mmwave_joint" type="fixed">
        <parent link="base_link"/>
        <child link="mmwave_link"/>
        <!-- 放在机体前上方，朝前 -->
        <origin xyz="0.18 0 0.08" rpy="0 0 0"/>
    </joint>

    <!-- 激光插件 -->
    <xacro:include filename="$(find lidar_robot)/urdf/plugins/gazebo_laser_plugin.xacro"/>
    <xacro:gazebo_laser_plugin/>

    <!-- 毫米波插件 -->
    <xacro:include filename="$(find lidar_robot)/urdf/plugins/gazebo_mmwave_plugin.xacro"/>
    <xacro:gazebo_mmwave_plugin/>

</robot>
