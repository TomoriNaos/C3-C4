<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fog_usv">
  <xacro:arg name="enable_c3_mmwave" default="true"/>

  <material name="pontoon_orange">
    <color rgba="1.0 0.42 0.08 1.0"/>
  </material>
  <material name="deck_dark">
    <color rgba="0.10 0.12 0.13 1.0"/>
  </material>
  <material name="sensor_black">
    <color rgba="0.01 0.01 0.01 1.0"/>
  </material>
  <material name="camera_blue">
    <color rgba="0.08 0.22 0.34 1.0"/>
  </material>

  <xacro:macro name="c3_raw_mmwave_sensor" params="name height topic">
    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.18" length="0.09"/>
        </geometry>
        <material name="sensor_black"/>
      </visual>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="-0.35 0 ${height}" rpy="0 0 0"/>
    </joint>

    <gazebo reference="${name}_link">
      <sensor type="ray" name="${name}_raw_sensor">
        <pose>0 0 0 0 0 0</pose>
        <visualize>false</visualize>
        <update_rate>15</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>400</samples>
              <resolution>1</resolution>
              <min_angle>-1.0472</min_angle>
              <max_angle>1.0472</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>1.0</min>
            <max>800.0</max>
            <resolution>0.5</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.08</stddev>
          </noise>
        </ray>
        <plugin name="gazebo_ros_${name}_raw" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <remapping>~/out:=${topic}</remapping>
          </ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>${name}_link</frame_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>

  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.28" rpy="0 0 0"/>
      <mass value="240.0"/>
      <inertia ixx="120.0" ixy="0.0" ixz="0.0" iyy="260.0" iyz="0.0" izz="320.0"/>
    </inertial>

    <visual name="port_pontoon">
      <origin xyz="0 0.95 0.0" rpy="0 ${pi / 2.0} 0"/>
      <geometry>
        <cylinder radius="0.24" length="5.4"/>
      </geometry>
      <material name="pontoon_orange"/>
    </visual>
    <visual name="starboard_pontoon">
      <origin xyz="0 -0.95 0.0" rpy="0 ${pi / 2.0} 0"/>
      <geometry>
        <cylinder radius="0.24" length="5.4"/>
      </geometry>
      <material name="pontoon_orange"/>
    </visual>
    <visual name="deck">
      <origin xyz="0 0 0.48" rpy="0 0 0"/>
      <geometry>
        <box size="3.3 1.55 0.18"/>
      </geometry>
      <material name="deck_dark"/>
    </visual>
    <visual name="bow_bridge">
      <origin xyz="1.15 0 0.72" rpy="0 0 0"/>
      <geometry>
        <box size="0.9 1.0 0.32"/>
      </geometry>
      <material name="deck_dark"/>
    </visual>
    <visual name="sensor_mast">
      <origin xyz="-0.35 0 1.18" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="1.28"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>

    <collision name="port_pontoon_collision">
      <origin xyz="0 0.95 0.0" rpy="0 ${pi / 2.0} 0"/>
      <geometry>
        <cylinder radius="0.26" length="5.5"/>
      </geometry>
    </collision>
    <collision name="starboard_pontoon_collision">
      <origin xyz="0 -0.95 0.0" rpy="0 ${pi / 2.0} 0"/>
      <geometry>
        <cylinder radius="0.26" length="5.5"/>
      </geometry>
    </collision>
    <collision name="deck_collision">
      <origin xyz="0 0 0.48" rpy="0 0 0"/>
      <geometry>
        <box size="3.4 1.65 0.22"/>
      </geometry>
    </collision>
  </link>

  <gazebo reference="base_link">
    <gravity>false</gravity>
    <velocity_decay>
      <linear>0.25</linear>
      <angular>0.35</angular>
    </velocity_decay>
    <material>Gazebo/Orange</material>
  </gazebo>

  <link name="mmwave_radar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.18" length="0.09"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>
  </link>
  <joint name="mmwave_radar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mmwave_radar_link"/>
    <origin xyz="-0.35 0 1.86" rpy="0 0 0"/>
  </joint>

  <gazebo reference="mmwave_radar_link">
    <sensor type="ray" name="mmwave_radar_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>8</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-${pi}</min_angle>
            <max_angle>${pi}</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.25</min>
          <max>120.0</max>
          <resolution>0.02</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_mmwave_radar" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=mmwave_radar/scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>mmwave_radar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <xacro:if value="$(arg enable_c3_mmwave)">
    <xacro:c3_raw_mmwave_sensor name="radar_10m" height="10.0" topic="radar_10m/raw_scan"/>
    <xacro:c3_raw_mmwave_sensor name="radar_4m" height="4.0" topic="radar_4m/raw_scan"/>
    <xacro:c3_raw_mmwave_sensor name="radar_1p9m" height="1.9" topic="radar_1p9m/raw_scan"/>
    <xacro:c3_raw_mmwave_sensor name="radar_1p5m" height="1.5" topic="radar_1p5m/raw_scan"/>
    <xacro:c3_raw_mmwave_sensor name="radar_1m" height="1.0" topic="radar_1m/raw_scan"/>
  </xacro:if>

  <link name="depth_camera_link">
    <visual>
      <geometry>
        <box size="0.18 0.16 0.12"/>
      </geometry>
      <material name="camera_blue"/>
    </visual>
  </link>
  <joint name="depth_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="depth_camera_link"/>
    <origin xyz="1.65 0 0.98" rpy="0 0 0"/>
  </joint>

  <gazebo reference="depth_camera_link">
    <sensor type="depth" name="depth_camera">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>10.0</update_rate>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>80.0</far>
        </clip>
      </camera>
      <plugin name="gazebo_ros_depth_camera" filename="libgazebo_ros_camera.so">
        <ros>
          <remapping>~/image_raw:=depth_camera/image_raw</remapping>
          <remapping>~/depth/image_raw:=depth_camera/depth/image_raw</remapping>
          <remapping>~/camera_info:=depth_camera/camera_info</remapping>
        </ros>
        <camera_name>depth_camera</camera_name>
        <frame_name>depth_camera_link</frame_name>
        <min_depth>0.1</min_depth>
        <max_depth>80.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>

  <link name="gated_camera_link">
    <visual>
      <geometry>
        <box size="0.20 0.18 0.14"/>
      </geometry>
      <material name="camera_blue"/>
    </visual>
  </link>
  <joint name="gated_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gated_camera_link"/>
    <origin xyz="1.55 0 1.20" rpy="0 0 0"/>
  </joint>

  <gazebo reference="gated_camera_link">
    <sensor type="camera" name="gated_camera">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>15.0</update_rate>
      <camera>
        <horizontal_fov>1.20</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>120.0</far>
        </clip>
      </camera>
      <plugin name="gazebo_ros_gated_camera" filename="libgazebo_ros_camera.so">
        <ros>
          <remapping>~/image_raw:=gated_camera/image_raw</remapping>
          <remapping>~/camera_info:=gated_camera/camera_info</remapping>
        </ros>
        <camera_name>gated_camera</camera_name>
        <frame_name>gated_camera_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <link name="als_lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.12"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>
  </link>
  <joint name="als_lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="als_lidar_link"/>
    <origin xyz="0.15 0 1.72" rpy="0 0 0"/>
  </joint>

  <gazebo reference="als_lidar_link">
    <sensor type="ray" name="als_lidar">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>5</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>240</samples>
            <resolution>1</resolution>
            <min_angle>-${pi}</min_angle>
            <max_angle>${pi}</max_angle>
          </horizontal>
          <vertical>
            <samples>8</samples>
            <resolution>1</resolution>
            <min_angle>-0.28</min_angle>
            <max_angle>0.12</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.3</min>
          <max>90.0</max>
          <resolution>0.03</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.015</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_als_lidar" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=als/points</remapping>
        </ros>
        <output_type>sensor_msgs/PointCloud2</output_type>
        <frame_name>als_lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <link name="sonar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 ${pi / 2.0} 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.16"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>
  </link>
  <joint name="sonar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sonar_link"/>
    <origin xyz="0.65 0 -0.28" rpy="0 ${pi / 2.0} 0"/>
  </joint>

  <gazebo reference="sonar_link">
    <sensor type="ray" name="sonar_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>6</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>9</samples>
            <resolution>1</resolution>
            <min_angle>-0.16</min_angle>
            <max_angle>0.16</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.2</min>
          <max>60.0</max>
          <resolution>0.03</resolution>
        </range>
      </ray>
      <plugin name="gazebo_ros_sonar" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=sonar/scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>sonar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
</robot>
