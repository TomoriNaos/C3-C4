<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="gazebo_mmwave_plugin">
        <gazebo reference="mmwave_link">
            <sensor name="mmwave_sensor" type="ray">
                <plugin name="mmwave_plugin" filename="libgazebo_ros_ray_sensor.so">
                    <ros>
                        <namespace>/</namespace>
                        <remapping>~/out:=mmwave/scan</remapping>
                    </ros>
                    <output_type>sensor_msgs/LaserScan</output_type>
                    <frame_name>mmwave_link</frame_name>
                </plugin>

                <always_on>true</always_on>
                <visualize>true</visualize>
                <update_rate>20</update_rate>
                <pose>0 0 0 0 0 0</pose>

                <ray>
                    <scan>
                        <horizontal>
                            <!-- 毫米波通常前向窄视场，这里做成 60 度 -->
                            <samples>120</samples>
                            <resolution>1.0</resolution>
                            <min_angle>-0.523599</min_angle>
                            <max_angle>0.523599</max_angle>
                        </horizontal>
                    </scan>

                    <range>
                        <min>0.2</min>
                        <max>30.0</max>
                        <resolution>0.05</resolution>
                    </range>

                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.03</stddev>
                    </noise>
                </ray>
            </sensor>
        </gazebo>
    </xacro:macro>
</robot>
