<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="fog_depth_camera_world">
    <include>
      <uri>model://sun</uri>
    </include>

    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.72 0.76 0.78 1</background>
    </scene>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.42 0.44 0.42 1</ambient>
            <diffuse>0.42 0.44 0.42 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="target_cube">
      <static>true</static>
      <pose>3.0 0.0 0.75 0 0 0</pose>
      <link name="cube_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.0 1.0 1.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.0 1.0 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.18 0.12 1</ambient>
            <diffuse>0.9 0.18 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="depth_camera_model">
      <static>true</static>
      <pose>0 0 1.0 0 0 0</pose>
      <link name="camera_depth_frame">
        <visual name="body">
          <geometry>
            <box>
              <size>0.25 0.12 0.12</size>
            </box>
          </geometry>
          <material>
            <ambient>0.08 0.08 0.08 1</ambient>
            <diffuse>0.08 0.08 0.08 1</diffuse>
          </material>
        </visual>
        <sensor type="depth" name="camera_sensor">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <visualize>false</visualize>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>B8G8R8</format>
            </image>
            <depth_camera>
            </depth_camera>
            <clip>
              <near>0.1</near>
              <far>20.0</far>
            </clip>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.003</stddev>
            </noise>
          </camera>
          <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
            <camera_name>camera</camera_name>
            <frame_name>camera_depth_frame</frame_name>
            <min_depth>0.1</min_depth>
            <max_depth>20.0</max_depth>
          </plugin>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
