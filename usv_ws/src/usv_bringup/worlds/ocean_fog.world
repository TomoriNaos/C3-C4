        <sensor type="camera" name="uav_long_range_camera">
          <pose>0.45 0 -0.10 0 0.22 0</pose>
          <visualize>false</visualize>
          <always_on>true</always_on>
          <update_rate>6.0</update_rate>
          <camera>
            <horizontal_fov>0.82</horizontal_fov>
            <image>
              <width>960</width>
              <height>540</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.2</near>
              <far>260.0</far>
            </clip>
          </camera>
          <plugin name="gazebo_ros_uav_long_range_camera" filename="libgazebo_ros_camera.so">
            <ros>
              <remapping>~/image_raw:=uav/front_camera/image_raw</remapping>
              <remapping>~/camera_info:=uav/front_camera/camera_info</remapping>
            </ros>
            <camera_name>uav_front_camera</camera_name>
            <frame_name>uav_front_camera_link</frame_name>
          </plugin>
        </sensor>

        <sensor type="ray" name="uav_als_lidar">
          <pose>0.12 0 -0.22 0 0.58 0</pose>
          <visualize>false</visualize>
          <always_on>true</always_on>
          <update_rate>4.0</update_rate>
          <ray>
            <scan>
              <horizontal>
                <samples>240</samples>
                <resolution>1</resolution>
                <min_angle>-0.70</min_angle>
                <max_angle>0.70</max_angle>
              </horizontal>
              <vertical>
                <samples>16</samples>
                <resolution>1</resolution>
                <min_angle>-0.34</min_angle>
                <max_angle>0.18</max_angle>
              </vertical>
            </scan>
            <range>
              <min>2.0</min>
              <max>260.0</max>
              <resolution>0.08</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.04</stddev>
            </noise>
          </ray>
          <plugin name="gazebo_ros_uav_als" filename="libgazebo_ros_ray_sensor.so">
            <ros>
              <remapping>~/out:=uav/als/points</remapping>
            </ros>
            <output_type>sensor_msgs/PointCloud2</output_type>
            <frame_name>uav_als_link</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

