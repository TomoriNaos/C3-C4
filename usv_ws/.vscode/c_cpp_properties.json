{
    "configurations": [
        {
            "name": "ROS2 Humble",
            "includePath": [
                "${workspaceFolder}/src/usv_perception/include",
                "${workspaceFolder}/install/**",
                "/opt/ros/humble/include/**",
                "/usr/include/opencv4",
                "/usr/include/gazebo-11",
                "/usr/include/sdformat-9.7",
                "${workspaceFolder}/**"
            ],
            "defines": [],
            "compilerPath": "/usr/bin/g++",
            "cStandard": "c17",
            "cppStandard": "gnu++17",
            "intelliSenseMode": "linux-gcc-x64",
            "compileCommands": "${workspaceFolder}/build/usv_perception/compile_commands.json",
            "browse": {
                "path": [
                    "${workspaceFolder}/src/usv_perception/include",
                    "${workspaceFolder}/install",
                    "/opt/ros/humble/include",
                    "/usr/include/opencv4",
                    "/usr/include/gazebo-11",
                    "/usr/include/sdformat-9.7",
                    "${workspaceFolder}"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ],
    "version": 4
}
