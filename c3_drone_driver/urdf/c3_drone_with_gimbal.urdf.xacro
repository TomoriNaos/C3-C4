<?xml version="1.0"?>
<robot name="c3_drone_with_gimbal" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="parent_link" default="base_link"/>
  <xacro:arg name="gimbal_mount_xyz" default="0.16 0.0 -0.04"/>
  <xacro:arg name="gimbal_mount_rpy" default="0 0 0"/>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.02" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.0" izz="0.04"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.36 0.36 0.10"/>
      </geometry>
      <material name="drone_gray">
        <color rgba="0.25 0.25 0.28 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.36 0.36 0.10"/>
      </geometry>
    </collision>
  </link>

  <joint name="gimbal_mount_joint" type="fixed">
    <parent link="$(arg parent_link)"/>
    <child link="gimbal_base_link"/>
    <origin xyz="$(arg gimbal_mount_xyz)" rpy="$(arg gimbal_mount_rpy)"/>
  </joint>

  <link name="gimbal_base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.18"/>
      <inertia ixx="0.00025" ixy="0.0" ixz="0.0" iyy="0.00025" iyz="0.0" izz="0.00035"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.030" length="0.020"/>
      </geometry>
      <material name="gimbal_black">
        <color rgba="0.08 0.08 0.08 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.030" length="0.020"/>
      </geometry>
    </collision>
  </link>

  <joint name="gimbal_yaw_joint" type="revolute">
    <parent link="gimbal_base_link"/>
    <child link="gimbal_yaw_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.4" upper="2.4" effort="2.0" velocity="1.2"/>
    <dynamics damping="0.2" friction="0.02"/>
  </joint>

  <link name="gimbal_yaw_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.14"/>
      <inertia ixx="0.00015" ixy="0.0" ixz="0.0" iyy="0.00015" iyz="0.0" izz="0.00025"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.025" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.050"/>
      </geometry>
      <material name="gimbal_dark">
        <color rgba="0.14 0.14 0.16 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.025" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.050"/>
      </geometry>
    </collision>
  </link>

  <joint name="gimbal_pitch_joint" type="revolute">
    <parent link="gimbal_yaw_link"/>
    <child link="gimbal_pitch_link"/>
    <origin xyz="0 0 -0.050" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.8" upper="0.6" effort="2.0" velocity="1.0"/>
    <dynamics damping="0.2" friction="0.02"/>
  </joint>

  <link name="gimbal_pitch_link">
    <inertial>
      <origin xyz="0.015 0 0" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="0.00010" ixy="0.0" ixz="0.0" iyy="0.00012" iyz="0.0" izz="0.00009"/>
    </inertial>
    <visual>
      <origin xyz="0.020 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.060 0.025 0.025"/>
      </geometry>
      <material name="gimbal_light">
        <color rgba="0.62 0.62 0.66 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.020 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.060 0.025 0.025"/>
      </geometry>
    </collision>
  </link>

  <joint name="tc_camera_joint" type="fixed">
    <parent link="gimbal_pitch_link"/>
    <child link="tc_camera_link"/>
    <origin xyz="0.050 0.020 0.0" rpy="0 0 0"/>
  </joint>

  <link name="tc_camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00002" ixy="0.0" ixz="0.0" iyy="0.00002" iyz="0.0" izz="0.00002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.030 0.030 0.020"/>
      </geometry>
      <material name="camera_blue">
        <color rgba="0.1 0.35 0.75 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.030 0.030 0.020"/>
      </geometry>
    </collision>
  </link>

  <joint name="gated_camera_joint" type="fixed">
    <parent link="gimbal_pitch_link"/>
    <child link="gated_camera_link"/>
    <origin xyz="0.050 -0.020 0.0" rpy="0 0 0"/>
  </joint>

  <link name="gated_camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00002" ixy="0.0" ixz="0.0" iyy="0.00002" iyz="0.0" izz="0.00002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.030 0.030 0.020"/>
      </geometry>
      <material name="camera_orange">
        <color rgba="0.85 0.45 0.10 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.030 0.030 0.020"/>
      </geometry>
    </collision>
  </link>

  <joint name="tc_optical_joint" type="fixed">
    <parent link="tc_camera_link"/>
    <child link="tc_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>
  <link name="tc_camera_optical_frame"/>

  <joint name="gated_optical_joint" type="fixed">
    <parent link="gated_camera_link"/>
    <child link="gated_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>
  <link name="gated_camera_optical_frame"/>
</robot>
